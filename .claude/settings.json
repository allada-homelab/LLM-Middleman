{
  "permissions": {
    "allow": [
      "Bash(just install *)",
      "Bash(just sync *)",
      "Bash(just test *)",
      "Bash(just test-int *)",
      "Bash(just mcp-probe *)",
      "Bash(just coverage *)",
      "Bash(just lint *)",
      "Bash(just lint-fix *)",
      "Bash(just fmt *)",
      "Bash(just fmt-check *)",
      "Bash(just typecheck *)",
      "Bash(just pre-commit *)",
      "Bash(just build *)",
      "Bash(just docs *)",
      "Bash(just docs-serve *)",
      "Bash(just compose-config *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-guardrails.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
