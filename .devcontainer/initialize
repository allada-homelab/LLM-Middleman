#!/usr/bin/env sh
# Runs on the HOST before the container is created. Ensures the files the
# read-only mounts bind to exist, so Docker doesn't materialize one as a
# directory, prepares the git plumbing the container needs to work in a linked
# worktree, and gives the container a usable git identity. POSIX hosts execute
# this script; on Windows, cmd.exe resolves `.devcontainer/initialize` to
# initialize.cmd via PATHEXT.
set -eu
# Every path below is resolved with `cd`; a CDPATH inherited from the host's
# shell would silently redirect that.
unset CDPATH

# A rootless daemon remaps the container's uid into a host subuid range, so
# everything written through the workspace bind mount lands owned by a phantom
# high uid and `.git` is unwritable from inside. Fail here rather than after a
# five-minute build. Silent when docker is absent — the CLI reports that itself.
if command -v docker >/dev/null 2>&1; then
    if docker info -f '{{.SecurityOptions}}' 2>/dev/null | grep -q rootless; then
        echo "initialize: docker is rootless; dev containers require the rootful daemon (uid mapping breaks the bind mount). Unset DOCKER_HOST." >&2
        exit 1
    fi
fi

# SSH: the container gets the host's agent socket, never ~/.ssh itself (see
# devcontainer.json). known_hosts is bind-mounted as a second trust file, so it
# must exist as a FILE: a missing source fails `docker run`.
# shellcheck disable=SC2174  # $HOME exists, so -m lands on .ssh, the only dir created
mkdir -p -m 700 "$HOME/.ssh"
if [ -d "$HOME/.ssh/known_hosts" ]; then
    echo "initialize: $HOME/.ssh/known_hosts is a directory, not a file. Docker creates" >&2
    echo "  a missing bind source that way. Remove it and start the container again." >&2
    exit 1
fi
[ -f "$HOME/.ssh/known_hosts" ] || : > "$HOME/.ssh/known_hosts"
# devcontainer.json binds ${localEnv:SSH_AUTH_SOCK:/dev/null}: the default covers
# only an UNSET variable. Docker rejects an empty or missing bind source with an
# error that names neither, and a dead socket mounts fine but serves nothing.
if [ -z "${SSH_AUTH_SOCK+set}" ]; then
    echo "initialize: WARNING SSH_AUTH_SOCK is unset — the container gets no SSH agent (fine for CI; start one on the host for git over ssh)" >&2
elif [ -z "$SSH_AUTH_SOCK" ]; then
    echo "initialize: SSH_AUTH_SOCK is set but empty — docker rejects an empty bind source; unset it or start an agent" >&2
    exit 1
elif [ ! -S "$SSH_AUTH_SOCK" ]; then
    echo "initialize: SSH_AUTH_SOCK=$SSH_AUTH_SOCK is not a live socket (stale agent env?) — start the agent / fix the env and retry" >&2
    exit 1
fi
# The git-identity section at the end of this script reads the host's global
# config, and git reports a fatal when that path is not a readable file. An
# earlier revision bind-mounted ~/.gitconfig itself, so a run from before it
# existed may have left Docker's auto-created directory behind.
if [ -d "$HOME/.gitconfig" ]; then
    echo "initialize: $HOME/.gitconfig is a directory, not a file. Docker created it" >&2
    echo "  that way during an earlier run. Remove it and start the container again." >&2
    exit 1
fi
[ -f "$HOME/.gitconfig" ] || : > "$HOME/.gitconfig"

# ---------------------------------------------------------------------------
# Git worktree support
#
# In a linked worktree, <workspace>/.git is a FILE holding an absolute pointer
# ("gitdir: /abs/parent/.git/worktrees/<name>") into the parent repository —
# a path outside the workspace bind mount. Git inside the container therefore
# dies during repository discovery with "fatal: not a git repository: (null)",
# and onCreateCommand exits 128 before anything else runs.
#
# devcontainer.json mounts are static and cannot branch on host state, so this
# script always produces the same two paths and devcontainer.json always mounts
# them; only what they point at differs:
#
#   .gitcommon -> the git COMMON dir            , mounted at /gitcommon
#   .gitentry  -> what the container sees as .git, mounted over <ws>/.git
#
# A bind mount's source type must match its target type (a directory cannot be
# mounted over a file, or vice versa), which is why .gitentry is a plain file in
# a worktree — where the host's .git is a file — and a symlink to the real .git
# directory in a normal checkout, where mounting it back over itself is a no-op.
# ---------------------------------------------------------------------------
dc=$(cd -- "$(dirname -- "$0")" && pwd)
ws=$(dirname -- "$dc")

if ! command -v git >/dev/null 2>&1; then
    echo "initialize: git not found on the host; cannot prepare the container's" >&2
    echo "  git mounts. Install git, or the container will start without a" >&2
    echo "  usable repository." >&2
    exit 1
fi
if ! git -C "$ws" rev-parse --git-dir >/dev/null 2>&1; then
    echo "initialize: $ws is not a git working tree. The dev container mounts the" >&2
    echo "  repository's git directory and cannot be built without one. Run" >&2
    echo "  'git init' in the project first." >&2
    exit 1
fi

common=$(cd -- "$ws" && cd -- "$(git rev-parse --git-common-dir)" && pwd)
gitdir=$(cd -- "$ws" && cd -- "$(git rev-parse --git-dir)" && pwd)

# Replace rather than update: a previous run — or Docker auto-creating a missing
# bind source — may have left either path as a directory of the wrong type.
rm -rf "$dc/.gitcommon" "$dc/.gitentry"

# The .venv named volume mounts INSIDE the workspace bind mount. Docker creates
# a missing mount point as root on the host, which a later host-side `uv sync`
# cannot remove (EACCES). Pre-create it as the host user so the mount point is
# ours; the volume shadows it in-container either way.
mkdir -p "$ws/.venv"
ln -s "$common" "$dc/.gitcommon"

# Branch on what `.git` actually IS, not on whether the git dir happens to equal
# the common dir: a `--separate-git-dir` checkout has `.git` as a *file* while
# those two are equal, and treating it as a normal checkout would make .gitentry a
# directory symlink that Docker then refuses to mount over a file.
if [ -d "$ws/.git" ]; then
    ln -s "$gitdir" "$dc/.gitentry"
elif [ "$gitdir" = "$common" ]; then
    printf 'gitdir: /gitcommon\n' > "$dc/.gitentry"
else
    printf 'gitdir: /gitcommon/worktrees/%s\n' "$(basename -- "$gitdir")" > "$dc/.gitentry"
fi

# ---------------------------------------------------------------------------
# Git identity
#
# The container gets a FLATTENED copy of the host's effective *global* config
# rather than a bind mount of ~/.gitconfig itself. A ~/.gitconfig that is only
# an `[include]` / `[includeIf]` shim — dotfiles managers, work/personal splits —
# points at paths that are not mounted, so the include resolves to nothing in
# there: `git config --get user.email` exits 1 and every commit, and every test
# that makes one, dies with "unable to auto-detect email address".
#
# `--includes` resolves those on the host, where the targets exist; `--global`
# keeps this to the user's own config so the repository's *local* settings are
# not promoted into the container's global one; and `-C "$ws"` gives git the
# repository context that `includeIf gitdir:` conditions are evaluated against
# (without it they are all false and a work/personal split picks neither).
#
# Values are copied verbatim except for keys that name host binaries (below).
# ---------------------------------------------------------------------------
gitconfig_host="$dc/.gitconfig.host"
# rm -rf, not rm -f: a run before this file existed let Docker materialise the
# missing bind source as a directory.
rm -rf "$gitconfig_host"
# Created even when the host has no global config, so the bind source always
# exists as a file. 0600 because credential and signing config can land in here.
(umask 077 && : > "$gitconfig_host")

# Captured first: POSIX sh has no pipefail, so a failing git on the left of a
# pipe would silently produce an empty copy — a container with no identity.
if ! host_config=$(git -C "$ws" config --global --includes --list); then
    echo "initialize: 'git config --global --includes --list' failed (see above); cannot write $gitconfig_host" >&2
    exit 1
fi
printf '%s\n' "$host_config" | while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    case "$entry" in
        *=*) key=${entry%%=*} value=${entry#*=} ;;
        # A valueless boolean (`[core] bare`) lists as a bare key; git reads it as true.
        *) key=$entry value=true ;;
    esac
    # `--list` lowercases section and key names, so these patterns need no case folding.
    case "$key" in
        # Already resolved above, and their targets are not mounted.
        include.* | includeif.*) continue ;;
        # Credential HELPERS are host-specific: the editor forwards its own helper
        # via /etc/gitconfig, and a copied `gh auth setup-git` block both clears
        # that list (its blank `helper =` reset) and names a host-only binary.
        # credential.useHttpPath and friends shape the request the forwarded
        # helper receives, so they still come across.
        credential.helper | credential.*.helper) continue ;;
        # Name host binaries (delta and the like): copied, they break `git log`
        # and `git add -p` in here instead of falling back to the defaults.
        core.pager | pager.* | interactive.difffilter) continue ;;
        # `--list` is line-based, so a value containing a newline arrives as
        # further lines that are not `section.key=value`. Warn and skip rather
        # than feed git a bogus key: a failure here means no container at all.
        *.*) ;;
        *)
            echo "initialize: skipping unparsable git config entry: $entry" >&2
            continue
            ;;
    esac
    git config -f "$gitconfig_host" --add "$key" "$value" ||
        echo "initialize: could not copy git config '$key' to $gitconfig_host" >&2
done
