# Host-specific git plumbing created by ./initialize and bind-mounted into the
# container so a git worktree checkout can resolve its gitdir. Points at
# absolute host paths, so it is never committed. See ./initialize.
.gitcommon
.gitentry

# Flattened copy of the host user's effective global git config, written by
# ./initialize and bind-mounted read-only so git in the container has an
# identity. Host-specific (and may hold credential settings). See ./initialize.
.gitconfig.host
